@page "/advertisements"
@inject ApiService Api
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService

<PageTitle>Advertisements</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h3">Advertisements</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateNew">Create New</MudButton>
</div>

@if (_isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudTable Items="@_ads" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="2">
        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>Title</MudTh>
            <MudTh>Direction</MudTh>
            <MudTh>Date</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Leads</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID">@context.Id</MudTd>
            <MudTd DataLabel="Title">@context.Title</MudTd>
            <MudTd DataLabel="Direction">@context.Direction</MudTd>
            <MudTd DataLabel="Date">@(context.DepartureDate?.ToString("dd.MM.yyyy") ?? "-")</MudTd>
            <MudTd DataLabel="Status">
                <MudChip Color="@GetStatusColor(context.Status)" Size="Size.Small">@context.Status</MudChip>
            </MudTd>
            <MudTd DataLabel="Leads">@context.TotalLeads</MudTd>
            <MudTd DataLabel="Actions">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditAd(context.Id))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteAd(context.Id))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private bool _isLoading = true;
    private List<AdResponse> _ads = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAds();
    }

    private async Task LoadAds()
    {
        _isLoading = true;
        try
        {
            _ads = await Api.GetAdsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading ads: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void CreateNew()
    {
        NavigationManager.NavigateTo("/advertisements/create");
    }

    private void EditAd(int id)
    {
        NavigationManager.NavigateTo($"/advertisements/edit/{id}");
    }

    private async Task DeleteAd(int id)
    {
        bool? result = await DialogService.ShowMessageBox(
            "Delete Confirmation",
            "Are you sure you want to delete this advertisement?",
            yesText: "Delete", cancelText: "Cancel");

        if (result == true)
        {
            try
            {
                await Api.DeleteAdAsync(id);
                Snackbar.Add("Advertisement deleted", Severity.Success);
                await LoadAds();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting ad: {ex.Message}", Severity.Error);
            }
        }
    }

    private Color GetStatusColor(AdStatus status) => status switch
    {
        AdStatus.Active => Color.Success,
        AdStatus.Draft => Color.Default,
        AdStatus.Paused => Color.Warning,
        AdStatus.Archived => Color.Dark,
        _ => Color.Default
    };
}
