@page "/"
@inject ApiService Api
@inject ISnackbar Snackbar

<PageTitle>Dashboard</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Dashboard</MudText>

@if (_isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="2" Class="pa-4">
                <MudText Typo="Typo.h6">Total Advertisements</MudText>
                <MudText Typo="Typo.h3" Color="Color.Primary">@_totalAds</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="2" Class="pa-4">
                <MudText Typo="Typo.h6">Total Views</MudText>
                <MudText Typo="Typo.h3" Color="Color.Info">@_totalViews</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="2" Class="pa-4">
                <MudText Typo="Typo.h6">Total Leads</MudText>
                <MudText Typo="Typo.h3" Color="Color.Success">@_totalLeads</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Elevation="2" Class="pa-4 mt-4">
                <MudText Typo="Typo.h6" GutterBottom="true">Top Performing Advertisements</MudText>
                <MudTable Items="@_analytics.Take(5)" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                    <HeaderContent>
                        <MudTh>Title</MudTh>
                        <MudTh>Views</MudTh>
                        <MudTh>Clicks</MudTh>
                        <MudTh>Messages Sent</MudTh>
                        <MudTh>CTR</MudTh>
                        <MudTh>Conversion Rate</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Title">@context.AdTitle</MudTd>
                        <MudTd DataLabel="Views">@context.TotalViews</MudTd>
                        <MudTd DataLabel="Clicks">@context.TotalClicks</MudTd>
                        <MudTd DataLabel="Messages Sent">@context.TotalMessagesSent</MudTd>
                        <MudTd DataLabel="CTR">@context.ClickThroughRate%</MudTd>
                        <MudTd DataLabel="Conversion Rate">@context.ConversionRate%</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private bool _isLoading = true;
    private List<AnalyticsResponse> _analytics = new();
    private int _totalAds = 0;
    private int _totalViews = 0;
    private int _totalLeads = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _analytics = await Api.GetAnalyticsSummaryAsync();
            var ads = await Api.GetAdsAsync();
            
            _totalAds = ads.Count;
            _totalViews = _analytics.Sum(a => a.TotalViews);
            _totalLeads = ads.Sum(a => a.TotalLeads);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading dashboard: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
